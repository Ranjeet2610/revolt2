{
  "name": "revolt-bot",
  "version": "1.0.0",
  "main": "puppeteer_revolt.js",
  "scripts": {
    "start": "node puppeteer_revolt.js",
    "start:aws": "node puppeteer_revolt.js --user aws-bot --headless=true",
    "start:pm2": "pm2 start ecosystem.config.js --env production",
    "stop:pm2": "pm2 stop revolt-bot",
    "restart:pm2": "pm2 restart revolt-bot",
    "logs:pm2": "pm2 logs revolt-bot",
    "docker:build": "docker build -t revolt-bot .",
    "docker:run": "docker run -d -p 3000-50000:3000-50000 --name revolt-bot revolt-bot",
    "docker:compose": "docker-compose up -d",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "revolt",
    "bot",
    "automation",
    "puppeteer",
    "discord-alternative"
  ],
  "author": "Your Name",
  "license": "MIT",
  "description": "A powerful Revolt bot with web dashboard for automated messaging and server management",
  "type": "module",
  "dependencies": {
    "args-parser": "^1.3.0",
    "axios": "^1.12.2",
    "express": "^4.21.2",
    "flatted": "^3.3.2",
    "open": "^10.1.0",
    "puppeteer": "^24.22.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "random-word-slugs": "^0.1.7",
    "readline": "^1.3.0",
    "revolt.io": "^1.0.0",
    "revolt.js": "^7.0.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.0.5"
  }
}